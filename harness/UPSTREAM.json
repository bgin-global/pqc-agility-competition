  "knownDefects": [
    {
      "id": "D-1",
      "where": "engine/gap.mjs draw()",
      "found": "2026-09-12, first stub round of the pqc-calibration instance (N = 65536, count = 10000)",
      "what": "one byte per pick: idx = bytes[k] % remaining.length, so every pick lands in the first 256 of the remaining list; a 10,000-draw from 65,536 reached index 10,230 at most (9,745 of 10,000 picks >= 256 only because the list shrinks). Exact for a census or N <= 256; a biased draw for a large bank, which a proposer could tune to.",
      "fix": "expand >= 4 bytes per pick and reduce a 32-bit unsigned modulo remaining.length (or rejection-sample); keep the census path unchanged",
      "status": "FIXED upstream in ea25f42 (draw v2: 32-bit rejection-sampled picks, 4-byte expansion counter; records carry drawVersion, v1 kept for replay) \u2014 vendored here 2026-09-12"
    },
    {
      "id": "D-2",
      "where": "engine/gap.mjs seedBytes()",
      "found": "2026-09-12, by reading",
      "what": "the expansion counter is one byte (counter & 0xff): after 256 blocks (8,192 bytes) the stream repeats, so draws needing more than 8,192 bytes reuse bytes",
      "fix": "a 4-byte big-endian counter in the expansion block",
      "status": "FIXED upstream in ea25f42 (draw v2: 32-bit rejection-sampled picks, 4-byte expansion counter; records carry drawVersion, v1 kept for replay) \u2014 vendored here 2026-09-12"
    },
    {
      "id": "D-3",
      "where": "templates/README.default.md (also README.md, SKILL.md)",
      "found": "2026-09-12, by this repository's link check on the vendored tree",
      "what": "[ENTRY.md](ENTRY.md) is a relative link that resolves only at the harness root; the template is copied into instance roots where no ENTRY.md exists. Documentation only.",
      "fix": "link the arrival contract by its upstream URL in the template, or drop the line from the template",
      "status": "nit, reported upstream; this repository's link check excludes harness/upstream (verified by its own gates)"
    }
  ],
