#!/usr/bin/env bash
# pre-push hook: refuse to push any commit that is not cryptographically signed with a verifiable key,
# or that lacks a DCO sign-off. Installed by scripts/setup-signing.sh via core.hooksPath.
# Signing before push is enforced here on the client; the GitHub rulesets enforce it again on the server.
set -uo pipefail
ZERO=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue            # branch deletion: nothing to verify
  if [ "$remote_sha" = "$ZERO" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  for c in $(git rev-list "$range" --not --remotes 2>/dev/null || git rev-list "$range"); do
    status="$(git log -1 --format='%G?' "$c")"
    case "$status" in
      G|U) ;;   # G = good signature; U = good signature, key not fully trusted (acceptable for SSH allowed_signers)
      *)   echo "pre-push: commit ${c:0:7} is not verifiably signed (status '$status'). See docs/SIGNING.md" >&2; fail=1 ;;
    esac
    if ! git log -1 --format='%B' "$c" | grep -q -E '^Signed-off-by: .+ <.+@.+>'; then
      echo "pre-push: commit ${c:0:7} has no Signed-off-by trailer (DCO.md)" >&2; fail=1
    fi
  done
done
if [ "$fail" -ne 0 ]; then
  echo "pre-push: refusing to push. Fix with: git rebase --exec 'git commit --amend --no-edit -s -S' <base>" >&2
  exit 1
fi
exit 0
